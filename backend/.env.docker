# =============================================================================
# Docker Environment — Used by docker-compose.yml
# =============================================================================
# Container networking uses service names (postgres, redis) as hostnames.
# =============================================================================

# ---- Server ----
NODE_ENV=development
PORT=3000

# ---- Database (points to the postgres container) ----
DATABASE_URL=postgresql://postgres:password@postgres:5432/roomies?schema=public

# ---- JWT Secrets ----
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- Redis (points to the redis container) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Bcrypt ----
BCRYPT_SALT_ROUNDS=12

# ---- CORS ----
CORS_ORIGIN=http://localhost:3000

# ---- Task / voting ----
TASK_MAX_RESUBMISSIONS=3
TASK_MAX_OPEN_PER_USER=2

# ---- Uploads (local fallback when Cloudinary is not set) ----
UPLOAD_DIR=/app/uploads
UPLOAD_PUBLIC_URL=http://localhost:3005/uploads

# ---- Cloudinary (set in backend/.env or override here) ----
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=roomies
