// =============================================================================
// Roomies Backend — Prisma Schema
// =============================================================================
// Fairness-Driven Task Allocation and Validation System
// All tables use UUID primary keys for distributed scalability.
// Indexes are placed on house_id columns for house-scoped query performance.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// USERS
// =============================================================================
// Core identity table. Stores credentials and account status.
// The `status` field supports soft-delete/deactivation patterns.
// =============================================================================
model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.Text
  email         String   @unique @db.Text
  passwordHash  String   @map("password_hash") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  status        String   @default("active") @db.Text

  // ---------- Relations ----------
  housesCreated    House[]        @relation("HouseCreator")
  memberships      HouseMember[]
  tasksAssigned    Task[]
  votes            Vote[]
  penalties        Penalty[]
  refreshTokens    RefreshToken[]
  swapsRequested   TaskSwap[]     @relation("SwapRequester")
  swapsReceived    TaskSwap[]     @relation("SwapReceiver")
  expensesPaid     Expense[]      @relation("ExpensePayer")
  expenseSplits    ExpenseSplit[] @relation("ExpenseSplitOwed")

  @@map("users")
}

// =============================================================================
// HOUSES
// =============================================================================
// Represents a shared living unit. Each house scopes all operations.
// `currentIndex` drives the round-robin task rotation engine.
// CRITICAL: This row must be locked (SELECT FOR UPDATE) during task assignment
// to prevent race conditions on the rotation index.
// =============================================================================
model House {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.Text
  inviteCode   String   @unique @map("invite_code") @db.VarChar(8)
  createdBy    String   @map("created_by") @db.Uuid
  currentIndex Int      @default(0) @map("current_index")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  // ---------- Relations ----------
  creator   User          @relation("HouseCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members   HouseMember[]
  tasks     Task[]
  swaps     TaskSwap[]
  expenses  Expense[]

  @@map("houses")
}

// =============================================================================
// HOUSE_MEMBERS
// =============================================================================
// Junction table linking users to houses with role-based access.
// `status` allows soft-removal (inactive) without deleting data.
// Members are ordered by `joinedAt` for deterministic rotation order.
// =============================================================================
model HouseMember {
  id       String   @id @default(uuid()) @db.Uuid
  houseId  String   @map("house_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     String   @default("member") @db.Text
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz
  status   String   @default("active") @db.Text

  // ---------- Relations ----------
  house House @relation(fields: [houseId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ---------- Indexes ----------
  // Prevent duplicate active memberships per house
  @@unique([houseId, userId])
  // Fast lookups for house-scoped queries
  @@index([houseId])
  @@index([userId])
  @@map("house_members")
}

// =============================================================================
// TASKS
// =============================================================================
// Core work unit. Assigned to a user within a house via the rotation engine.
// Status transitions: pending → submitted → completed/rejected/disputed
//                     pending → expired (via background job)
// Allowed status values: 'pending' | 'submitted' | 'completed' | 'rejected'
//                        | 'expired' | 'disputed'
// =============================================================================
model Task {
  id           String   @id @default(uuid()) @db.Uuid
  houseId      String   @map("house_id") @db.Uuid
  assignedTo   String   @map("assigned_to") @db.Uuid
  title        String   @db.Text
  status       String   @default("pending") @db.Text
  deadline     DateTime @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  // ---------- Gamification & Weighting ----------
  rewardPoints Int      @default(10) @map("reward_points")
  penaltyFine  Decimal  @default(50.0) @map("penalty_fine") @db.Decimal(10, 2)

  // ---------- Recurring Task Fields ----------
  isRecurring   Boolean @default(false) @map("is_recurring")
  cronSchedule  String? @map("cron_schedule") @db.Text

  // ---------- Proof & AI Fields ----------
  imageUrl   String?  @map("image_url") @db.Text
  aiScore    Float?   @map("ai_score")
  aiVerdict  String?  @map("ai_verdict") @db.Text

  // ---------- Re-submission Tracking ----------
  resubmissionCount   Int     @default(0) @map("resubmission_count")
  currentSubmissionId String? @unique @map("current_submission_id") @db.Uuid

  // ---------- Relations ----------
  house             House            @relation(fields: [houseId], references: [id], onDelete: Cascade)
  assignee          User             @relation(fields: [assignedTo], references: [id], onDelete: Cascade)
  currentSubmission TaskSubmission?  @relation("CurrentSubmission", fields: [currentSubmissionId], references: [id], onDelete: SetNull)
  submissions       TaskSubmission[] @relation("TaskSubmissions")
  votes             Vote[]
  penalties         Penalty[]
  offeredSwaps      TaskSwap[]       @relation("OfferedTask")
  requestedSwaps    TaskSwap[]       @relation("RequestedTask")

  // ---------- Indexes ----------
  @@index([houseId])
  @@index([assignedTo])
  @@index([status])
  @@index([deadline])
  @@map("tasks")
}

// =============================================================================
// TASK SUBMISSIONS
// =============================================================================
// Each proof upload creates a submission record (voting round).
// Prior submissions and their votes are preserved for history/timeline.
// =============================================================================
model TaskSubmission {
  id             String   @id @default(uuid()) @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  attemptNumber  Int      @map("attempt_number")
  imageUrl       String?  @map("image_url") @db.Text
  clarification  String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  // ---------- Relations ----------
  task           Task  @relation("TaskSubmissions", fields: [taskId], references: [id], onDelete: Cascade)
  currentForTask Task? @relation("CurrentSubmission")
  votes          Vote[]

  @@unique([taskId, attemptNumber])
  @@index([taskId])
  @@map("task_submissions")
}

// =============================================================================
// VOTES
// =============================================================================
// Records per-user approval/rejection decisions on a specific submission round.
// The UNIQUE constraint on (submission_id, user_id) enforces one vote per user
// per voting round at the database level.
// =============================================================================
model Vote {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  vote         String   @db.Text // 'approve' | 'reject'
  reason       String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  // ---------- Relations ----------
  task       Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submission TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ---------- Constraints ----------
  @@unique([submissionId, userId])
  @@index([taskId])
  @@index([submissionId])
  @@map("votes")
}

// =============================================================================
// PENALTIES
// =============================================================================
// Tracks penalty events from rejected tasks or expired deadlines.
// Points and fines are stored per-event; aggregated scores are computed
// dynamically via SQL (never stored as derived state).
// Allowed status values: 'unpaid' | 'settled' | 'forgiven'
// =============================================================================
model Penalty {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  points     Int      @default(10)
  fineAmount Decimal  @default(50) @map("fine_amount") @db.Decimal(10, 2)
  status     String   @default("unpaid") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // ---------- Relations ----------
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // ---------- Indexes ----------
  @@index([userId])
  @@index([taskId])
  @@map("penalties")
}

// =============================================================================
// TASK SWAPS
// =============================================================================
// Peer-to-peer chore swap requests between house members.
// Only 'pending' tasks may be swapped.  The atomic swap of assignedTo on both
// tasks happens inside a Prisma transaction when the receiver accepts.
//
// Allowed status values: 'pending' | 'accepted' | 'rejected' | 'canceled'
// =============================================================================
model TaskSwap {
  id              String   @id @default(uuid()) @db.Uuid
  houseId         String   @map("house_id") @db.Uuid
  requesterId     String   @map("requester_id") @db.Uuid
  receiverId      String   @map("receiver_id") @db.Uuid
  offeredTaskId   String   @map("offered_task_id") @db.Uuid
  requestedTaskId String   @map("requested_task_id") @db.Uuid
  status          String   @default("pending") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // ---------- Relations ----------
  house         House @relation(fields: [houseId], references: [id], onDelete: Cascade)
  requester     User  @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver      User  @relation("SwapReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  offeredTask   Task  @relation("OfferedTask", fields: [offeredTaskId], references: [id], onDelete: Cascade)
  requestedTask Task  @relation("RequestedTask", fields: [requestedTaskId], references: [id], onDelete: Cascade)

  // ---------- Indexes ----------
  @@index([houseId])
  @@index([requesterId])
  @@index([receiverId])
  @@map("task_swaps")
}

// =============================================================================
// EXPENSES
// =============================================================================
// Records a shared expense paid by one member on behalf of the house.
// The cost is split equally across all active members at creation time.
// The payer's own split is auto-marked 'settled'; all others start 'unpaid'.
// =============================================================================
model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  houseId     String   @map("house_id") @db.Uuid
  paidBy      String   @map("paid_by") @db.Uuid
  amount      Decimal  @db.Decimal(10, 2)
  description String   @db.Text
  receiptUrl  String?  @map("receipt_url") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  // ---------- Relations ----------
  house  House          @relation(fields: [houseId], references: [id], onDelete: Cascade)
  payer  User           @relation("ExpensePayer", fields: [paidBy], references: [id], onDelete: Cascade)
  splits ExpenseSplit[]

  // ---------- Indexes ----------
  @@index([houseId])
  @@index([paidBy])
  @@map("expenses")
}

// =============================================================================
// EXPENSE SPLITS
// =============================================================================
// Per-member share of a shared expense.
// Allowed status values: 'unpaid' | 'settled'
// Settlement can be triggered by either the owedBy member or the expense payer.
// =============================================================================
model ExpenseSplit {
  id        String   @id @default(uuid()) @db.Uuid
  expenseId String   @map("expense_id") @db.Uuid
  owedBy    String   @map("owed_by") @db.Uuid
  amount    Decimal  @db.Decimal(10, 2)
  status    String   @default("unpaid") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // ---------- Relations ----------
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation("ExpenseSplitOwed", fields: [owedBy], references: [id], onDelete: Cascade)

  // ---------- Indexes ----------
  @@index([expenseId])
  @@index([owedBy])
  @@map("expense_splits")
}

// =============================================================================
// REFRESH TOKENS
// =============================================================================
// Stores hashed refresh tokens for JWT rotation.
// Supports multiple device sessions per user.
// Tokens are invalidated on logout and rotated on refresh.
// =============================================================================
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  revoked   Boolean  @default(false)
  userAgent String?  @map("user_agent") @db.Text
  ipAddress String?  @map("ip_address") @db.VarChar(45)

  // ---------- Relations ----------
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ---------- Indexes ----------
  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}
