# ============================================
# Roomies Backend — Environment Configuration
# ============================================

# ---- Server ----
NODE_ENV=development
PORT=4001

# ---- Database (Neon Postgres) ----
# Pooled URL for the app (use -pooler host + pgbouncer=true)
# connection_limit should match Neon pool size (free tier ~10; use 5-9 for app)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/roomies?sslmode=require&pgbouncer=true&connect_timeout=15&connection_limit=5
# Direct URL for migrations (non-pooler host)
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/roomies?sslmode=require&connect_timeout=15

# ---- JWT Secrets ----
JWT_ACCESS_SECRET=your-access-secret-here-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-here-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- Redis (Upstash — for BullMQ) ----
# From https://console.upstash.com — REST creds are auto-converted to a rediss:// URL
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Or set REDIS_URL directly: rediss://default:token@your-endpoint.upstash.io:6379

# ---- Bcrypt ----
BCRYPT_SALT_ROUNDS=12

# ---- CORS ----
CORS_ORIGIN=http://localhost:4000
FRONTEND_URL=http://localhost:4000

# ---- SMTP (optional — password reset emails; link logged to console when unset) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Google OAuth ----
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4001/api/auth/google/callback

# ---- File uploads (local fallback) ----
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_URL=http://localhost:4001/uploads

# ---- Cloudinary (recommended for production; all three required to enable) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=roomies
