# ============================================
# Roomies Backend — Test Environment
# ============================================
NODE_ENV=test
PORT=4099
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/roomies_test?sslmode=require
JWT_ACCESS_SECRET=test-access-secret-minimum-16-chars-ok
JWT_REFRESH_SECRET=test-refresh-secret-minimum-16-chars-ok
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d
REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379
BCRYPT_SALT_ROUNDS=4
CORS_ORIGIN=http://localhost:4000
