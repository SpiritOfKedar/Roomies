# ============================================
# Roomies Backend — Test Environment
# ============================================
# Docker postgres is mapped host:5433 → container:5432
NODE_ENV=test
PORT=3099
DATABASE_URL=postgresql://postgres:password@localhost:5433/roomies?schema=public
JWT_ACCESS_SECRET=test-access-secret-minimum-16-chars-ok
JWT_REFRESH_SECRET=test-refresh-secret-minimum-16-chars-ok
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
BCRYPT_SALT_ROUNDS=4
CORS_ORIGIN=http://localhost:3001
